[user]
	email = boris.chernystrand@gmail.com
	name = fvrrrn
[init]
	defaultBranch = master
[core]
	editor = nvim
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[difftool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[merge]
	tool = nvimdiff
[mergetool]
	prompt = true
[mergetool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c 'wincmd w' -c 'wincmd J'"
